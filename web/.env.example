# web/.env.example — copy to .env.local for local dev (never commit real
# secrets; .env* is already gitignored).

# ── Simulation funnel ─────────────────────────────────────────────────────────
# Where the web app reads world state, chronicle pages, and deaths from.
# The live funnel (Tailscale, dedicated PC):
NEXT_PUBLIC_API_URL=https://servermac.tailaad45c.ts.net:8443
# Local dev against a sim running on your machine instead:
# NEXT_PUBLIC_API_URL=http://localhost:3001

# ── World identity ────────────────────────────────────────────────────────────
# Centralizes the world's display name (lib/worldName.ts). Leave unset to use
# the default "Aethel" — a rename is a pending owner decision, not yet made.
# NEXT_PUBLIC_WORLD_NAME=Aethel

# ── Firebase Admin (server-only; the vote API routes) ────────────────────────
# REQUIRED for real ballot writes. Without it, /api/vote and /api/tally fall
# back to an in-memory dev stub (see lib/vote/tallyStore.ts) so the rest of
# the flow still works locally — but nothing is durable and nothing is shared
# across visitors/processes.
#
# Paste the service-account JSON for the chronicles-14b34 Firebase project as
# ONE line (same pattern simulation/firebase.ts already uses in prod). NEVER
# commit the raw file or this value.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...", ...}

# ── Buttondown email capture ──────────────────────────────────────────────────
# The owner hasn't created the Buttondown account yet. Until this is set,
# lib/vote/EmailCapture.tsx renders a graceful "not configured yet" message
# instead of a broken embed.
# NEXT_PUBLIC_BUTTONDOWN_USERNAME=your-buttondown-username
